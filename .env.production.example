APP_NAME="Selva Electricals"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://store.selvaelectricals.lk
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_CPANEL_DATABASE
DB_USERNAME=REPLACE_WITH_CPANEL_DATABASE_USER
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=REPLACE_WITH_MAIL_HOST
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=REPLACE_WITH_AUTHORIZED_SENDER
MAIL_FROM_NAME="Selva Electricals"
